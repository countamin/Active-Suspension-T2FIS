import numpy as np
import matplotlib.pyplot as plt
import time

# سازگاری با NumPy >= 2.0 که np.trapz را به np.trapezoid تغییر نام داده
_trapz = np.trapezoid if hasattr(np, 'trapezoid') else np.trapz

# تنظیم دانه تصادفی
np.random.seed(42)

# ============================================================
# ۱. پارامترهای فیزیکی سیستم تعلیق
# ============================================================
ms, mus = 500, 40
ks, kt = 10000, 150000
cs = 1000
e_max, de_max, f_max = 0.025, 3.5, 900


ks_nl = 0.3 * ks

mf_params = {
    'NB': [-1.75, -1.5, -1.25, -1, -0.75, -0.5, -0.25],
    'NS': [-1.25, -1, -0.75, -0.5, -0.25, 0, 0.25],
    'ZE': [-0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75],
    'PS': [-0.25, 0, 0.25, 0.5, 0.75, 1, 1.25],
    'PB': [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75]
}


# ============================================================
# ۲. تابع عضویت α-plane
# ============================================================

def get_alpha_membership_fast(x, p, alpha):
    """
    محاسبه سریع کران پایین و بالای عضویت در سطح alpha.
    """
    a, b, c, m, c2, b2, a2 = p

    t1 = t2 = t3 = 0.0

    if x < m:
        if x > a:
            t1 = (x - a) / (m - a)

        if x > b:
            t2 = (
                0.2 * ((x - a) / (m - a))**4
                + 0.8 * 0.5 * (x - c) / (m - c)
            )

        if x > c:
            t3 = 0.5 * (x - c) / (m - c)

    else:
        if x < a2:
            t1 = (a2 - x) / (a2 - m)

        if x < b2:
            t2 = (
                0.2 * ((a2 - x) / (a2 - m))**4
                + 0.8 * 0.5 * (c2 - x) / (c2 - m)
            )

        if x < c2:
            t3 = 0.5 * (c2 - x) / (c2 - m)

    # کران بالا
    u = max(
        0.0,
        min(
            1.0,
            t1 - alpha * (t1 - t2)
        )
    )

    # کران پایین
    l = max(
        0.0,
        min(
            1.0,
            t3 + alpha * (t2 - t3)
        )
    )

    return l, u


# ============================================================
# نمایش آزمایشی تابع عضویت
# ============================================================

p_test = [-0.75, -0.5, -0.25, 0, 0.25, 0.5, 0.75]

x_range = np.linspace(-1, 1, 500)

alphas = [0, 1]
colors = ['red', 'green', 'blue']

plt.figure(figsize=(10, 6))

for alpha, col in zip(alphas, colors):

    l_vals = []
    u_vals = []

    for x in x_range:

        l, u = get_alpha_membership_fast(
            x,
            p_test,
            alpha
        )

        l_vals.append(l)
        u_vals.append(u)

    # رسم ناحیه FOU
    plt.fill_between(
        x_range,
        l_vals,
        u_vals,
        color=col,
        alpha=0.3,
        label=f'Alpha = {alpha}'
    )

    plt.plot(
        x_range,
        u_vals,
        color=col,
        linestyle='--',
        linewidth=1
    )

    plt.plot(
        x_range,
        l_vals,
        color=col,
        linewidth=1.5
    )

plt.title(
    "Visual Validation of Contracting GT2 Membership Function"
)

plt.xlabel("Normalized Input")
plt.ylabel("Membership Degree")

plt.legend()
plt.grid(True, alpha=0.3)

plt.axvline(
    0,
    color='black',
    alpha=0.5
)

plt.show()


# ============================================================
# ۳. موتور استنتاج T2FIS
#
#     این قسمت طبق فرمول صفحه اصلاح شده است.
#
#     مرحله ۱:
#
#     y_L^(alpha) =
#       sum_j [w_L,j^(alpha) * b_j]
#       --------------------------------
#       sum_j [w_L,j^(alpha)]
#
#     y_U^(alpha) =
#       sum_j [w_U,j^(alpha) * b_j]
#       --------------------------------
#       sum_j [w_U,j^(alpha)]
#
#     مرحله ۲:
#
#     y_L =
#       sum_k [alpha_k * y_L^(alpha_k)]
#       ---------------------------------
#       sum_k alpha_k
#
#     y_U =
#       sum_k [alpha_k * y_U^(alpha_k)]
#       ---------------------------------
#       sum_k alpha_k
#
#     مرحله ۳:
#
#     y = 0.5 * (y_L + y_U)
#
# ============================================================

def type2_inference(e_val, de_val):

    # --------------------------------------------------------
    # نرمال‌سازی ورودی‌ها + نویز سنسور
    # --------------------------------------------------------

    e_in = max(
        -1.0,
        min(
            1.0,
            e_val / e_max + np.random.normal(0, 0.08)
        )
    )

    de_in = max(
        -1.0,
        min(
            1.0,
            de_val / de_max + np.random.normal(0, 0.07)
        )
    )

    # --------------------------------------------------------
    # سطوح alpha
    # --------------------------------------------------------

    alpha_levels = np.linspace(0.1, 1.0, 10)

    # --------------------------------------------------------
    # متغیرهای ورودی
    # --------------------------------------------------------

    labels = ['NB', 'ZE', 'PB']

    # --------------------------------------------------------
    # Rule base
    #
    #             de
    #          NB  ZE  PB
    #
    # e  NB    PB  PS  ZE
    #    ZE    PS  ZE  NS
    #    PB    ZE  NS  NB
    # --------------------------------------------------------

    rule_table = [
        ['PB', 'PS', 'ZE'],
        ['PS', 'ZE', 'NS'],
        ['ZE', 'NS', 'NB']
    ]

    # ========================================================
    # مرحله اول:
    # محاسبه خروجی مستقل برای هر alpha
    # ========================================================

    alpha_weighted_y_l = 0.0
    alpha_weighted_y_u = 0.0

    alpha_sum_l = 0.0
    alpha_sum_u = 0.0

    for alpha in alpha_levels:

        # ----------------------------------------------------
        # این چهار متغیر فقط مربوط به همین alpha هستند.
        #
        # بنابراین برخلاف روش قبلی، اطلاعات alpha قبلی
        # وارد این محاسبه نمی‌شود.
        # ----------------------------------------------------

        num_l_alpha = 0.0
        den_l_alpha = 0.0

        num_u_alpha = 0.0
        den_u_alpha = 0.0

        # ====================================================
        # محاسبه firing strength تمام قوانین در alpha فعلی
        # ====================================================

        for i, e_lab in enumerate(labels):

            for j, de_lab in enumerate(labels):

                out_lab = rule_table[i][j]

                # --------------------------------------------
                # alpha-cut ورودی اول
                # --------------------------------------------

                l_e, u_e = get_alpha_membership_fast(
                    e_in,
                    mf_params[e_lab],
                    alpha
                )

                # --------------------------------------------
                # alpha-cut ورودی دوم
                # --------------------------------------------

                l_de, u_de = get_alpha_membership_fast(
                    de_in,
                    mf_params[de_lab],
                    alpha
                )

                # --------------------------------------------
                # firing interval
                # --------------------------------------------

                f_l = min(l_e, l_de)
                f_u = min(u_e, u_de)

                # --------------------------------------------
                # singleton consequent
                # --------------------------------------------

                c_m = mf_params[out_lab][3]

                # --------------------------------------------
                # خروجی پایین برای همین alpha
                # --------------------------------------------

                num_l_alpha += f_l * c_m
                den_l_alpha += f_l

                # --------------------------------------------
                # خروجی بالا برای همین alpha
                # --------------------------------------------

                num_u_alpha += f_u * c_m
                den_u_alpha += f_u

        # ====================================================
        # مرحله دوم:
        #
        # تشکیل y_L^(alpha) و y_U^(alpha)
        #
        # این دقیقاً همان مرحله‌ای است که در کد قبلی
        # وجود نداشت.
        # ====================================================

        if den_l_alpha > 1e-6 and den_u_alpha > 1e-6:

            y_l_alpha = (
                num_l_alpha / den_l_alpha
            )

            y_u_alpha = (
                num_u_alpha / den_u_alpha
            )

        else:
            # در صورت نبودن firing strength معتبر،
            # خروجی این alpha تعریف نشده است.
            # در ساختار فعلی rule base انتظار می‌رود
            # این حالت رخ ندهد.
            continue

        # ====================================================
        # مرحله سوم:
        #
        # alpha-weighted aggregation
        #
        # y_L =
        #   sum alpha*y_L^(alpha) / sum alpha
        #
        # y_U =
        #   sum alpha*y_U^(alpha) / sum alpha
        # ====================================================

        alpha_weighted_y_l += alpha * y_l_alpha
        alpha_weighted_y_u += alpha * y_u_alpha

        alpha_sum_l += alpha
        alpha_sum_u += alpha

    # ========================================================
    # مرحله چهارم:
    # تشکیل خروجی نهایی پایین و بالا
    # ========================================================

    if alpha_sum_l > 1e-12 and alpha_sum_u > 1e-12:

        Y_l = (
            alpha_weighted_y_l
            / alpha_sum_l
        )

        Y_u = (
            alpha_weighted_y_u
            / alpha_sum_u
        )

        # ====================================================
        # مرحله پنجم:
        # crisp output
        # ====================================================

        y_crisp = (
            0.5 * (Y_l + Y_u) * f_max
        )

    else:

        y_crisp = 0.0

    return y_crisp


# ============================================================
# ۴. مدل دینامیکی و حلگر RK4
# ============================================================

def road_profile(t):

    if 1.0 <= t <= 1.2:

        return (
            0.05
            * np.sin(
                np.pi * (t - 1.0) / 0.2
            )
        )

    elif 5.0 <= t <= 5.5:

        return (
            -0.01
            * np.sin(
                np.pi * (t - 1.0) / 0.2
            )
        )

    elif 5.5 <= t <= 6.5:

        return (
            -0.07
            * np.sin(
                np.pi * (t - 0.7) / 0.1
            )
        )

    return 0


# ============================================================
# نیروی فنر غیرخطی
# ============================================================

def spring_force(dx):

    return (
        ks * dx
        + ks_nl * dx ** 3
    )


# ============================================================
# معادلات دینامیکی quarter-car
# ============================================================

def suspension_ode(t, y, fa):

    xs, dxs, xus, dxus = y

    xr = road_profile(t)

    ddxs = (
        spring_force(xus - xs)
        + cs * (dxus - dxs)
        + fa
    ) / ms

    ddxus = (
        spring_force(xs - xus)
        + cs * (dxs - dxus)
        + kt * (xr - xus)
        - fa
    ) / mus

    return np.array([
        dxs,
        ddxs,
        dxus,
        ddxus
    ])


# ============================================================
# ۵. شبیه‌سازی
# ============================================================

dt = 0.01
T_end = 20.0

time_steps = np.arange(
    0,
    T_end,
    dt
)

# شرایط اولیه
state = np.zeros(4)

res_xs = []
res_acc = []
res_fa = []

print("Alpha-plane approach using the specified per-alpha formulation.")

start_t = time.perf_counter()


# ============================================================
# حلقه زمانی
# ============================================================

for t in time_steps:

    # --------------------------------------------------------
    # کنترلر T2FIS
    # --------------------------------------------------------

    fa = type2_inference(
        state[0],
        state[1] - state[3]
    )

    # --------------------------------------------------------
    # Runge-Kutta 4th order
    # --------------------------------------------------------

    k1 = suspension_ode(
        t,
        state,
        fa
    )

    k2 = suspension_ode(
        t + dt / 2,
        state + dt * k1 / 2,
        fa
    )

    k3 = suspension_ode(
        t + dt / 2,
        state + dt * k2 / 2,
        fa
    )

    k4 = suspension_ode(
        t + dt,
        state + dt * k3,
        fa
    )

    state += (
        dt / 6
        * (
            k1
            + 2 * k2
            + 2 * k3
            + k4
        )
    )

    # --------------------------------------------------------
    # ذخیره نتایج
    # --------------------------------------------------------

    res_xs.append(state[0])
    res_acc.append(k1[1])
    res_fa.append(fa)


end_t = time.perf_counter()


# ============================================================
# ۶. تبدیل نتایج به NumPy array
# ============================================================

res_acc = np.array(res_acc)
res_xs = np.array(res_xs)
res_f = np.array(res_fa)


# ============================================================
# ۷. معیارهای عملکرد
# ============================================================

# ------------------------------------------------------------
# Sprung acceleration
# ------------------------------------------------------------

iae_acc = _trapz(
    np.abs(res_acc),
    time_steps
)

itae_acc = _trapz(
    time_steps * np.abs(res_acc),
    time_steps
)


# ------------------------------------------------------------
# Body displacement
# ------------------------------------------------------------

iae_xs = _trapz(
    np.abs(res_xs),
    time_steps
)

itae_xs = _trapz(
    time_steps * np.abs(res_xs),
    time_steps
)


# ============================================================
# RMS و Peak
# ============================================================

metrics = {

    'RMS': [

        np.sqrt(
            np.mean(
                np.square(res_acc)
            )
        ),

        np.sqrt(
            np.mean(
                np.square(res_xs)
            )
        ),

        np.sqrt(
            np.mean(
                np.square(res_f)
            )
        )
    ],

    'Peak': [

        np.max(
            np.abs(res_acc)
        ),

        np.max(
            np.abs(res_xs)
        ),

        np.max(
            np.abs(res_f)
        )
    ]
}


# ============================================================
# ۸. نمایش نتایج
# ============================================================

print(f"Maximum force: {np.max(res_f):.10f} N")
print(f"Minimum force: {np.min(res_f):.10f} N")
print(f"Maximum normalized force: {np.max(res_f)/f_max:.10f}")
print(f"Minimum normalized force: {np.min(res_f)/f_max:.10f}")
print(
    f"\nSimulation Time: "
    f"{end_t - start_t:.2f} seconds"
)

print(
    f"\n{'=' * 40}\n"
    f"   PERFORMANCE METRICS (PER-ALPHA METHOD)\n"
    f"{'=' * 40}"
)

print(
    f"Sprung Acc (RMS):   "
    f"{metrics['RMS'][0]:.4f} m/s²"
)

print(
    f"Sprung Acc (Peak):  "
    f"{metrics['Peak'][0]:.4f} m/s²"
)

print(
    f"Sprung Acc (IAE):   "
    f"{iae_acc:.4f}"
)

print(
    f"Sprung Acc (ITAE):  "
    f"{itae_acc:.4f}"
)

print(
    f"{'-' * 40}"
)

print(
    f"Body Disp (RMS):    "
    f"{metrics['RMS'][1]:.4f} m"
)

print(
    f"Body Disp (Peak):   "
    f"{metrics['Peak'][1]:.4f} m"
)

print(
    f"Body Disp (IAE):    "
    f"{iae_xs:.4f}"
)

print(
    f"Body Disp (ITAE):   "
    f"{itae_xs:.4f}"
)

print(
    f"{'-' * 40}"
)

print(
    f"Force (RMS):       "
    f"{metrics['RMS'][2]:.2f} N"
)

print(
    f"Force (Peak):      "
    f"{metrics['Peak'][2]:.2f} N"
)

print(
    f"{'=' * 40}"
)


# ============================================================
# ۹. رسم نمودار نهایی
# ============================================================

plt.figure(figsize=(10, 5))

plt.plot(
    time_steps,
    res_acc,
    label='Body Acceleration (Comfort)',
    color='red'
)

plt.grid(True)
plt.legend()

plt.xlabel('Time (s)')
plt.ylabel('Acceleration (m/s²)')

plt.show()
